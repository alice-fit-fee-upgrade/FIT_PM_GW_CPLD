#!/usr/bin/env python3
import json,sys
from jedlib import read
a=read(sys.argv[1])
b=read(sys.argv[2])
if a['qf']!=b['qf']: raise SystemExit('QF mismatch')
diff=[i for i,(x,y) in enumerate(zip(a['fuses'],b['fuses'])) if x!=y]
print(json.dumps(dict(qf=a['qf'],hamming_distance=len(diff),different_fuses=diff,
                     warning='Raw fuse comparison alone does not establish semantic equivalence.'),indent=2))
