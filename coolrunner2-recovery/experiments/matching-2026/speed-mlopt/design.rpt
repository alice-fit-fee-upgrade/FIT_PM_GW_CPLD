	c_count<6> & !c_count<7>
	# CLK40 & CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & !c_count<8>
	# CLK40 & CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & !c_count<9>
	# CLK40 & CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & cal_phase & !inhibit_pipe<0> & !inhibit_pipe<1> & 
	!inhibit_pipe<2> & !inhibit_pipe<3>
	# CLK40 & !CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & c_count<7> & c_count<8> & c_count<9> & 
	!cal_phase & !inhibit_pipe<0> & !inhibit_pipe<1> & 
	!inhibit_pipe<2> & !inhibit_pipe<3>;	// (5 pt, 17 inp)
   c_count<7>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

c_count<8>.T := CLK40 & CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & c_count<7> & !c_count<8>
	# CLK40 & CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & c_count<7> & !c_count<9>
	# CLK40 & CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & c_count<7> & cal_phase & !inhibit_pipe<0> & 
	!inhibit_pipe<1> & !inhibit_pipe<2> & !inhibit_pipe<3>
	# CLK40 & !CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & c_count<7> & c_count<8> & c_count<9> & 
	!cal_phase & !inhibit_pipe<0> & !inhibit_pipe<1> & 
	!inhibit_pipe<2> & !inhibit_pipe<3>;	// (4 pt, 17 inp)
   c_count<8>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

c_count<9>.T := CLK40 & CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & c_count<7> & c_count<8> & !c_count<9>
	# CLK40 & CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & c_count<7> & c_count<8> & c_count<9> & 
	cal_phase & !inhibit_pipe<0> & !inhibit_pipe<1> & 
	!inhibit_pipe<2> & !inhibit_pipe<3>
	# CLK40 & !CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & c_count<7> & c_count<8> & c_count<9> & 
	!cal_phase & !inhibit_pipe<0> & !inhibit_pipe<1> & 
	!inhibit_pipe<2> & !inhibit_pipe<3>;	// (3 pt, 17 inp)
   c_count<9>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

cal_phase.T := CLK40 & CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & c_count<7> & c_count<8> & c_count<9> & 
	cal_phase & !inhibit_pipe<0> & !inhibit_pipe<1> & 
	!inhibit_pipe<2> & !inhibit_pipe<3>
	# CLK40 & !CLK20_P & c_count<0> & c_count<1> & 
	c_count<2> & c_count<3> & c_count<4> & c_count<5> & 
	c_count<6> & c_count<7> & c_count<8> & c_count<9> & 
	!cal_phase & !inhibit_pipe<0> & !inhibit_pipe<1> & 
	!inhibit_pipe<2> & !inhibit_pipe<3>;	// (2 pt, 17 inp)
   cal_phase.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

cal_sample := CLK40;	// (1 pt, 1 inp)
   cal_sample.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)
    cal_sample.CE = N_PZ_340;	// (1 pt, 1 inp)

dly<0> := str1 & !str2
	# !str1 & str2;	// (2 pt, 2 inp)
   dly<0>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

dly<1> := dly<0>;	// (1 pt, 1 inp)
   dly<1>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

dly<2> := dly<1>;	// (1 pt, 1 inp)
   dly<2>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

dly<3> := dly<2>;	// (1 pt, 1 inp)
   dly<3>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

dly<4> := dly<3>;	// (1 pt, 1 inp)
   dly<4>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

dly<5> := dly<4>;	// (1 pt, 1 inp)
   dly<5>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

dly<6> := dly<5>;	// (1 pt, 1 inp)
   dly<6>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

inhibit_pipe<0> := raw_stretch;	// (1 pt, 1 inp)
   inhibit_pipe<0>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)
    inhibit_pipe<0>.CE = !CLK40;	// (1 pt, 1 inp)

inhibit_pipe<1> := inhibit_pipe<0>;	// (1 pt, 1 inp)
   inhibit_pipe<1>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)
    inhibit_pipe<1>.CE = !CLK40;	// (1 pt, 1 inp)

inhibit_pipe<2> := inhibit_pipe<1>;	// (1 pt, 1 inp)
   inhibit_pipe<2>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)
    inhibit_pipe<2>.CE = !CLK40;	// (1 pt, 1 inp)

inhibit_pipe<3> := inhibit_pipe<2>;	// (1 pt, 1 inp)
   inhibit_pipe<3>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)
    inhibit_pipe<3>.CE = !CLK40;	// (1 pt, 1 inp)

raw_edge := raw_sync<1> & !raw_sync<2>
	# !raw_sync<1> & raw_sync<2>;	// (2 pt, 2 inp)
   raw_edge.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

!raw_str_toggle.T := Gnd;	// (0 pt, 0 inp)
    raw_str_toggle.CLK = !(STR);	// CTC	(1 pt, 1 inp)

!raw_stretch := CLK40 & !raw_stretch
	# !CLK40 & raw_sync<1> & raw_sync<2> & !raw_edge
	# !CLK40 & !raw_sync<1> & !raw_sync<2> & !raw_edge;	// (3 pt, 5 inp)
   raw_stretch.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

raw_sync<0> := raw_str_toggle;	// (1 pt, 1 inp)
   raw_sync<0>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

raw_sync<1> := raw_sync<0>;	// (1 pt, 1 inp)
   raw_sync<1>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

raw_sync<2> := raw_sync<1>;	// (1 pt, 1 inp)
   raw_sync<2>.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)

str1 := str_div;	// (1 pt, 1 inp)
   str1.CLK  =  !CLK80;	// GCK	(0 pt, 0 inp)
    str1.CE = !CLK40;	// (1 pt, 1 inp)

str2 := str1;	// (1 pt, 1 inp)
   str2.CLK  =  CLK80;	// GCK	(0 pt, 0 inp)


// Direct Input Register
str_div.T := ENA;	// (0 pt, 0 inp)
    str_div.CLK = !(STR);	// CTC	(1 pt, 1 inp)

Control Term Legend:
Clock         - GCK    - Global Clock
                CTC    - Block Control Term Clock
                PTC    - Product Term Clock
                CLKDIV - Clock Divider
Preset        - GSR    - Global Set
                CTS    - Block Control Term Preset
                PTA    - Product Term Preset
Reset         - GSR    - Global Reset
                CTR    - Block Control Term Reset
                PTA    - Product Term Reset
Output Enable - GTS    - Global Tristate
                CTE    - Block Control Term Output Enable
                PTB    - Product Term Output Enable

Legend:  <signame>.COMB = combinational node mapped to the same physical macrocell
                          as the FastInput "signal" (not logically related)
